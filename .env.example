# Supabase project connection. The Lovable Cloud / Supabase integration
# generates src/integrations/supabase/client.ts from these at build time —
# do not edit that file directly, set these instead.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Same values, without the VITE_ prefix, for server-side rendering.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Storefront contact number shown in the footer, e.g. tel:+911145678900.
# Digits only, with country code, no spaces or punctuation.
VITE_STORE_PHONE=
